# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in Supabase: the Connect button at the top, or Project Settings › API Keys.
# Both are safe to put in the app. Never put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-key
